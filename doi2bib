# ===========================================================================
# COMMAND-LINE INTERFACE
# ===========================================================================

def _parse_cli_args() -> argparse.Namespace:
    """Parse ``sys.argv``.

    The positional argument is still called ``doi`` for backwards
    compatibility with the original script, but it now also accepts a URL
    (for NeurIPS / DOI-less conferences).
    """
    parser = argparse.ArgumentParser()
    parser.add_argument("doi", help=" DOI or conference URL")
    parser.add_argument(
        "-v", "--verbosity",
        action="count",
        help="increase output verbosity",
    )
    return parser.parse_args()


def main() -> int:
    """Script entry point. Returns a POSIX exit code."""
    global DEBUG

    printDEBUG(1, "VERBOSITY LEVEL = " + str(DEBUG))
    try:
        args = _parse_cli_args()
        if args.verbosity:
            DEBUG = args.verbosity
            print("Verbositiy increased")
        doi = args.doi

        get_linenumber()

        # ``resolve_input`` routes DOIs to the classical pipeline and URLs
        # to the conference-handler registry; falls back to ``get_entry``
        # so the legacy error messages are preserved.
        data = resolve_input(doi)
        print(data)
    except IndexError:
        print("No DOI provided")
        return 1
    except Exception as exc:
        print(exc)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
