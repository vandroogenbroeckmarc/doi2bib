def lastWord(string: str) -> str:
    """Return the last whitespace-separated token of *string*."""
    lis = list(string.split(" "))
    return lis[len(lis) - 1]


def organize_authors(string: str) -> str:
    """
    Normalise an ``author`` field to the ``"Last, First and Last, First"`` form.

    If the string already contains commas the original form is preserved; if
    any entry is literally ``"et al."`` a warning is emitted on stdout.
    """
    if string.find('and et al.') != -1:
        print("\nWARNING, there is an 'et al.' in the list of authors!!")

    if string.find(',') > 1:
        return string

    authors = string.split("and")
    for i in range(len(authors)):
        author    = authors[i].rstrip().lstrip()
        lastname  = lastWord(author).rstrip().lstrip()
        firstname = author.replace(lastname, '').rstrip().lstrip()
        authors[i] = lastname + ', ' + firstname
    return " and ".join(authors)


