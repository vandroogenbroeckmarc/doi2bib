def dl_abbrev(fname: str = 'abbrev.txt.gz') -> None:
    """Download the ISSN LTWA abbreviation list into the citation data dir."""
    url = LATEST_ISSN
    printDEBUG(2, "Fetching the file " + url + " to build abbrev.txt.gz")
    r = requests.get(url, allow_redirects=True)
    data = r.content
    directory = data_home('citation')
    makedirs(directory)

    with gzip.open(os.path.join(directory, fname), 'wb') as f:
        f.write(data)


def load_abbrev(fname: str) -> Dict[str, str]:
    """
    Load the ISSN abbreviations database as a ``{word: abbreviation}`` dict.

    The database is (re-)downloaded automatically when missing or out of date.
    """
    target = os.path.join(data_home('citation'), fname)
    printDEBUG(2, "TARGET = " + target)

    if not os.path.isfile(target):
        print("%s not found; downloading..." % target)
        dl_abbrev(fname)

    mtime = datetime.date.fromtimestamp(os.path.getmtime(target))
    if not mtime > ISSN_UPD:
        print("%s is out of date; redownloading..." % target)
        dl_abbrev(fname)

    data: Dict[str, str] = {}
    with gzip.open(target, 'rt', encoding="utf-16") as f:
        for line in f:
            # Skip the header line
            if line.startswith('WORD'):
                continue
            parts = line.split("\t")
            jname = parts[0]
            jabbrev = parts[1]
            data[jname.lower()] = jabbrev.lower()
    return data


def _lookup_single_abbrev(word: str, data: Dict[str, str]) -> Optional[str]:
    """Return the LTWA abbreviation for a single *word* (or None if none matches)."""
    for k, v in data.items():
        # Keys ending in ``-`` are prefix patterns
        if k.endswith("-"):
            if word.lower().startswith(k[:-1]):
                return v.capitalize() if v != "n.a." else word.lower().capitalize()
        else:
            if word.lower() == k:
                return v.capitalize() if v != "n.a." else word.lower().capitalize()
    return None


def journal_abbrev(name: str) -> str:
    """Return an abbreviated journal title for *name* based on the ISSN LTWA."""
    printDEBUG(2, "Loading abbreviation for journal as ")
    printDEBUG(3, "Printing the full (long) list of abbreviations...")
    printDEBUG(3, load_abbrev(os.path.join(sys.path[0] + "abbrev.txt.gz")))

    data = load_abbrev(os.path.join(sys.path[0], "abbrev.txt.gz"))

    name, _, _ = name.partition(":")
    parts = re.split(r"\s+", name)

    # Short one-word titles are returned unchanged.
    if len(parts) == 1 and len(parts[0]) < 12:
        return name

    abbreviated: List[str] = []
    for word in parts:
        if word.lower() in IGNORELIST:
            continue

        hit = _lookup_single_abbrev(word, data)
        if hit is not None:
            abbreviated.append(hit)
        else:
            # Words already fully upper-case are preserved, otherwise Title-cased.
            abbreviated.append(word if word.isupper() else word.capitalize())

    return " ".join(abbreviated)


