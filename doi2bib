# Month string-to-literal substitution (bibtexparser would otherwise keep braces)
_MONTH_CAPITALISATION: Dict[str, str] = {
    '{jan}': 'Jan', '{feb}': 'Feb', '{mar}': 'Mar', '{apr}': 'Apr',
    '{may}': 'May', '{jun}': 'Jun', '{jul}': 'Jul', '{aug}': 'Aug',
    '{sep}': 'Sep', '{oct}': 'Oct', '{nov}': 'Nov', '{dec}': 'Dec',
    '{january}': 'Jan', '{february}': 'Feb', '{march}': 'Mar', '{april}': 'Apr',
    '{june}': 'Jun', '{july}': 'Jul', 'july': 'Jul', '{august}': 'Aug',
    '{september}': 'Sep', '{october}': 'Oct', '{november}': 'Nov', '{december}': 'Dec',
}

# Misc. string clean-ups applied to the final serialised entry.
_FINAL_STRING_FIXES: List[Tuple[str, str]] = [
    ('\\textendash ', '-'),
    ('<title>',       ''),
    ('</title>',      ''),
    ('\u2019',        '\''),             # bad apostrophe
]

# Deterministic field order in the emitted BibTeX record.
_BIBTEX_FIELD_ORDER: Tuple[str, ...] = (
    'ENTRYTYPE', 'title', 'author', 'journal', 'booktitle',
    'shortjournalproceedings', 'howpublished', 'series', 'volume', 'number',
    'pages', 'month', 'year', 'institution', 'school', 'publisher',
    'eprint', 'address', 'editor', 'keywords', 'eprinttype', 'doi', 'url',
)


def _strip_braces_around_strings(bibtex_str: str, abbr: Dict[str, str]) -> str:
    """Remove the braces that ``bibtexparser`` wraps around ``@string`` names."""
    for abbr_key in abbr:
        bibtex_str = bibtex_str.replace(
            '= {' + str(abbr_key) + '}',
            '= '  + str(abbr_key),
        )
    return bibtex_str


def _brace_special_words_in_title(bibtex_str: str) -> str:
    """Re-brace words like ``2D`` or ``Gaussian`` on the *title* line only."""
    lines = bibtex_str.split('\n')
    title_line = lines[1]
    if 'title = ' not in title_line:
        return bibtex_str

    new_title = title_line
    for item in ACRONYMS + MULTI_D + PROPER_NAMES + ALGORITHMS + CITIES + COUNTRIES:
        new_title = new_title.replace(item, "{" + item + "}")
    return bibtex_str.replace(title_line, new_title)


def _format_as_bibtex(db, abbr: Dict[str, str]) -> str:
    """Serialise *db* to a canonical BibTeX string ready to be printed."""
    writer = BibTexWriter()
    writer.indent         = '\t'
    writer.display_order  = _BIBTEX_FIELD_ORDER
    bibtex_str = bibtexparser.dumps(db, writer)

    # Month literals
    for src, dst in _MONTH_CAPITALISATION.items():
        bibtex_str = bibtex_str.replace(src, dst)

    # Remove {} around any @string name
    bibtex_str = _strip_braces_around_strings(bibtex_str, abbr)

    # Small string clean-ups
    for src, dst in _FINAL_STRING_FIXES:
        bibtex_str = bibtex_str.replace(src, dst)

    # Add braces around acronyms / names / etc. on the title line
    bibtex_str = _brace_special_words_in_title(bibtex_str)
    return bibtex_str


