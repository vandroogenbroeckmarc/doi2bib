    "Ā": r"{\=A}", "Ē": r"{\=E}", "Ō": r"{\=O}", "Ū": r"{\=U}",
    # Stroke / slashed
    "ø": r"{\o}", "Ø": r"{\O}", "ł": r"{\l}", "Ł": r"{\L}",
    "đ": r"{\dj}", "Đ": r"{\DJ}",
    # Dot above
    "ż": r"{\.z}", "Ż": r"{\.Z}", "ė": r"{\.e}", "Ė": r"{\.E}",
    # Ligatures
    "æ": r"{\ae}", "Æ": r"{\AE}", "œ": r"{\oe}", "Œ": r"{\OE}", "ß": r"{\ss}",
    # Icelandic / other Latin
    "þ": r"{\th}", "Þ": r"{\TH}", "ð": r"{\dh}", "Ð": r"{\DH}",
    # Smart quotes / apostrophes (occasional in author middle names)
    "\u2018": "`",  "\u2019": "'",
    "\u201C": "``", "\u201D": "''",
    # Dashes occasionally used in hyphenated surnames
    "\u2013": "--", "\u2014": "---",
    "\u2010": "-",  "\u2011": "-", "\u2212": "-",
    # Spaces sometimes present in scraped HTML
    "\u00A0": "~",  "\u2009": " ",  "\u202F": "~",  "\u2007": " ",
    "\u200B": "",   "\u200C": "",   "\u200D": "",   "\uFEFF": "",
}


def author_list_has_et_al(author: str) -> bool:
    """True if *author* ends with an 'et al.' marker."""
    a = (author or '').strip()
    return bool(_ET_AL_TAIL_RE.search(a) or _ET_AL_ALONE_RE.search(a))


def normalise_et_al_tail(author: str) -> str:
    """Rewrite '... and et al.' / '... et al.' to '... et al'."""
    a = (author or '').strip()
    a = _ET_AL_TAIL_RE.sub(' et al', a)
    a = _ET_AL_ALONE_RE.sub('et al', a)
    return a


def fetch_arxiv_authors(eprint_id: str) -> Optional[List[str]]:
    """Return the full author list for arxiv.org/abs/<eprint_id>.

    Uses the per-author ``<meta name="citation_author">`` tags, which
    arXiv exposes on every abs page in canonical "Last, First" form.
    Returns ``None`` on any failure (network, parse).
    """
    url = f"https://arxiv.org/abs/{eprint_id}"
    try:
        html = getContentFromURL(url)
    except Exception as exc:
        printDEBUG(1, f"arxiv fetch failed for {url}: {exc}")
        return None
    authors = _ARXIV_META_AUTHOR_RE.findall(html)
    return authors or None


def _apply_ascii_substitutions(text: str) -> str:
    """Replace every non-ASCII character in *text* with its LaTeX/BibTeX
    equivalent, using the inline ``_AUTHOR_ASCII_SUBSTITUTIONS`` table.

    This is a self-contained substitution loop — it never silently
    no-ops, so every scraped arXiv author written by
    :func:`build_arxiv_etal_full` is guaranteed to be ASCII-clean for
    every character in the table. Any code point that is *not* in the
    table is passed through unchanged and reported via ``printDEBUG`` so
    the user can add it.
    """
    if not text:
        return text
    out: List[str] = []
    missing: Dict[str, int] = {}
    for ch in text:
        if ord(ch) < 128:
            out.append(ch)
            continue
        repl = _AUTHOR_ASCII_SUBSTITUTIONS.get(ch)
        if repl is None:
            out.append(ch)
            missing[ch] = missing.get(ch, 0) + 1
        else:
            out.append(repl)
    if missing:
        for ch, n in sorted(missing.items(), key=lambda p: -p[1]):
            printDEBUG(1,
                f"ascii-fix: unhandled U+{ord(ch):04X} {ch!r} "
                f"(x{n}); add to _AUTHOR_ASCII_SUBSTITUTIONS")
    return "".join(out)


_AUTHOR_SPLIT_RE = re.compile(r'\s+and\s+', re.IGNORECASE)


def count_named_authors_before_et_al(author: str) -> int:
    """Count the explicitly-named authors in *author* before the 'et al.'
    marker.

    For example:
      "Cioppa and Deliège and et al."       -> 2
      "Smith, J. and Doe, J. and et al."    -> 2
      "Smith et al."                         -> 1  (single name before tail)
      "et al."                               -> 0
    """
    a = (author or '').strip()
    # Drop the tail in either of its forms.
    a = _ET_AL_TAIL_RE.sub('', a)
    a = _ET_AL_ALONE_RE.sub('', a)
    a = a.strip().rstrip(',').strip()
    if a.lower().endswith(' and'):
        a = a[:-4].rstrip()
    if not a:
        return 0
    parts = [p.strip() for p in _AUTHOR_SPLIT_RE.split(a) if p.strip()]
    return len(parts)


def build_arxiv_etal_short(entry: dict,
                           scraped: Optional[List[str]] = None) -> dict:
    """Return a *copy* of *entry* in which the author list is the first
    ``K`` scraped arXiv authors (canonical "Last, First" form, ASCII-
    cleaned) followed by ``et al``; the key gets ``-etal`` appended.

    ``K`` is the number of explicitly-named authors the original entry
    had before its "et al." marker, so the short form keeps the same
    visible length while gaining uniform "Last, First" formatting.

    If *scraped* is ``None`` (or empty), or if the original entry has
    no named authors, this falls back to the previous behaviour: the
    user-typed author list with its tail normalised to ``et al``. That
    way the short form is still emitted when the arXiv scrape fails.
    """
    short = dict(entry)
    k = count_named_authors_before_et_al(entry.get('author', ''))
    if scraped and k > 0:
        first_k = [_apply_ascii_substitutions(a.strip())
                   for a in scraped[:k] if a and a.strip()]
        if first_k:
            short['author'] = ' and '.join(first_k) + ' et al'
        else:
            short['author'] = normalise_et_al_tail(entry.get('author', ''))
    else:
        short['author'] = normalise_et_al_tail(entry.get('author', ''))
    key = entry.get('ID', '')
    if not key.endswith('-etal'):
        key = key + '-etal'
    short['ID'] = key
    return short


def build_arxiv_etal_full(entry: dict,
                          scraped: Optional[List[str]] = None) -> Optional[dict]:
    """Return a *copy* of *entry* with only the ``author`` field replaced
    by the full arXiv author list in canonical "Last, First" form,
    joined by ``" and "``, and ASCII-cleaned via
    :func:`_apply_ascii_substitutions`.

    *scraped* is the list previously obtained with
    :func:`fetch_arxiv_authors`; if ``None`` is supplied the function
    will scrape on its own. Returns ``None`` if scraping fails or the
    entry lacks an ``eprint`` field.

    All other fields — including ``ID``, ``title``, ``journal``, … —
    are preserved byte-for-byte; by the time this runs, the main
    pipeline has already finalised the key (with the ``-arxiv`` suffix)
    and the title braces, so rebuilding either one here would only
    undo that work.
    """
    if scraped is None:
        eprint = entry.get('eprint')
        if not eprint:
            return None
        scraped = fetch_arxiv_authors(eprint)
        if not scraped:
            return None
    if not scraped:
        return None
    cleaned = [_apply_ascii_substitutions(a.strip())
               for a in scraped if a and a.strip()]
    if not cleaned:
        return None
    full = dict(entry)
    full['author'] = ' and '.join(cleaned)
    return full


