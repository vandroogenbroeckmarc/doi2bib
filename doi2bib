def _fetch_raw_bibtex(doi: str) -> str:
    """Retrieve the raw BibTeX payload for *doi* from ``doi.org``."""
    url = f"https://doi.org/{doi}"
    printDEBUG(1, "Fetching " + url)

    raw = requests.get(
        url,
        headers={'Accept': 'text/x-bibliography;style=bibtex'},
        timeout=200,
    )

    if raw.status_code != 200:
        print(
            "The returned status code of the metadata server is wrong: "
            + str(raw.status_code) + " instead of 200"
        )
    else:
        printDEBUG(
            1,
            "\treturn code of the fetched metadata is ok ("
            + str(raw.status_code) + "); proceeding with analysis",
        )
        printDEBUG(2, "Raw content is " + raw.content.decode('utf-8'))

    if not (raw.ok and raw.status_code == 200):
        raise Exception(
            "Could not get data for \"%s\" from CrossRef (status code)" %
            (url, raw.status_code)
        )
    return raw.content.decode('utf-8')


def _parse_bibtex(content: str, doi: str):
    """Return a ``BibDatabase`` parsed from *content* with a few quirks applied."""
    parser = BibTexParser()
    parser.customization  = homogenize_latex_encoding
    parser.common_strings = True

    get_linenumber()
    # Some arXiv IDs contain spaces -> replace the key by a placeholder.
    if doi.find("10.48550/") > -1:
        content = re.sub("{(.*), title", "{IDToBeReplaced, title", content)

    # Some IEEE references encode ``month=sep`` instead of ``month={sep}``.
    # See 10.1109/ICRCV59470.2023.10329030.
    content = re.sub("month=([a-z]+)", "month={\\1}", content)

    get_linenumber()
    content = re.sub("month=June", "month=Jun", content)
    content = re.sub("month=July", "month=Jul", content)
    content = re.sub("month=Sept", "month=Sep", content)

    db = bibtexparser.loads(content, parser=parser)
    if len(db.entries) >= 1:
        return db

    print("\nRaw content is " + content + "\n")
    print("This is a missformed BiBTeX entry... exiting")
    exit()


def _normalise_base_entry(entry: dict) -> None:
    """Cleanup operations that happen on every entry, regardless of publisher."""
    # Authors -----------------------------------------------------------------
    entry['author'] = organize_authors(entry['author'])

    # Title: drop the leading { and trailing } around capitalised letters -----
    entry['title'] = re.sub(r'\{', '', entry['title'])
    entry['title'] = re.sub(r'\}', '', entry['title'])

    # Crossref occasionally returns ``http://dx.doi.org`` instead of HTTPS.
    if 'url' in entry:
        entry['url'] = re.sub(r'http://dx.doi.org', 'https://doi.org', entry['url'])

    # Journal -----------------------------------------------------------------
    if 'journal' in entry:
        if '&amp;' in entry['journal']:
            printDEBUG(1, "Replacing &amp by & in the journal name")
            entry['journal'] = entry['journal'].replace('&amp;', '&')

        jabbr = journal_abbrev(entry['journal'])
        if jabbr != entry['journal']:
            entry['shortjournalproceedings'] = jabbr

        # Crossref is not always well-formatted and sometimes tags
        # conference/workshop papers as ``journal``.
        if ('onference' in entry['journal']) or ('orkshop' in entry['journal']):
            entry['ENTRYTYPE'] = "inproceedings"
            entry['booktitle'] = entry['journal']
            del entry['journal']
            if entry.get('address') is None:
                entry['address'] = ''

    # Month -------------------------------------------------------------------
    if 'month' in entry:
        entry['month'] = entry['month'].lower()


def _sanitize_after_key(entry: dict) -> None:
    """Extra clean-up (doi / url / title / field removal) after the key is built."""
    entry['doi']   = entry['doi'].replace("\\",               "")
    entry['url']   = entry['url'].replace("\\",               "")
    entry['title'] = entry['title'].replace("\\textquotesingle ", "'")
    entry['title'] = entry['title'].replace("\\textquotedblleft",  "``")
    entry['title'] = entry['title'].replace("\\textquotedblright", "''")
    entry['title'] = entry['title'].replace("\n",                 "")
    entry['title'] = entry['title'].replace("\\&lt;title\\&gt;",  "")   # old SPIE
    entry['title'] = entry['title'].replace("\\&lt;/title\\&gt;", "")   # old SPIE

    # Protect mid-word acronyms / all-upper words by wrapping in braces.
    for item in re.findall(r'\w+[A-Z]+\w+|[A-Z][A-Z]+', entry['title']):
        entry['title'] = entry['title'].replace(item, "{" + item + "}")

    # Drop noisy fields.
    for stale in ('abstractnote', 'issn', 'isbn'):
        if stale in entry:
            del entry[stale]

    # Always ensure a ``keywords`` key exists.
    entry.setdefault('keywords', '')


def _log_raw_content(new_key: str, doi_content: str) -> None:
    """Dump the raw DOI payload to the log directory (best effort)."""
    if LOGGING <= 0:
        return
    try:
        filename = path_to_log + new_key
        printDEBUG(2, "Printing the raw doi content in " + filename)
        with open(filename, "w") as f:
            f.write(doi_content)
    except OSError as e:
        print("Could not open file:", e)


def _load_string_abbreviations() -> Dict[str, str]:
    """Load the ``@string{...}`` table defined in ``abbreviation.bib``."""
    with open(path_to_file_abbreviation) as f:
        bib_database_abbr = bibtexparser.load(f)
    return bib_database_abbr.strings


def _apply_cvpr_special_case(entry: dict) -> None:
    """Populate the ``address`` of CVPR(W) entries from the yearly lookup."""
    if 'booktitle' not in entry:
        return
    if entry['booktitle'] in ('icvpr', 'icvprw'):
        entry['address'] = CVPR_CITY_BY_YEAR[int(entry['year'])]
        printDEBUG(1, "Found icvpr and adding address " + entry['address'])
        entry['keywords'] = ''
        del entry['shortjournalproceedings']
        entry.setdefault('pages', '')


def _apply_preprint_handlers(entry: dict) -> dict:
    """Run every preprint-server handler whose DOI prefix matches."""
    for prefix, handler in PREPRINT_HANDLERS:
        if prefix in entry['doi']:
            entry = handler(entry)
    return entry


def _abbreviate_journal(entry: dict, abbr: Dict[str, str]) -> None:
    """Replace ``journal`` with its LTWA key when a close match exists."""
    if 'journal' not in entry:
        return

    best_ratio, best_key = _best_match(entry['journal'], abbr)
    if best_ratio > 0:
        printDEBUG(
            1,
            "Current best match for [" + entry['journal'] + "]: "
            + abbr[best_key] + " ( " + best_key + ") -> " + str(best_ratio),
        )

    if best_ratio > 0.95 or (best_ratio > 0.8 and len(abbr[best_key]) > 40):
        printDEBUG(2, "Changing " + entry['journal'] + " by ")
        printDEBUG(2, abbr[best_key])
        if best_ratio < 0.98:
            print(
                "\nIMPORTANT NOTE -- VERIFY if this is correct: substituting\n\t"
                + entry['journal'] + " by\n\t " + abbr[best_key]
            )
        entry['journal'] = best_key
        if 'shortjournalproceedings' in entry:
            del entry['shortjournalproceedings']


def _abbreviate_booktitle(entry: dict, abbr: Dict[str, str]) -> None:
    """Strip any year from the booktitle and match it against the LTWA db."""
    if 'booktitle' not in entry:
        return

    year = entry['year'] + " "
    if year in entry['booktitle']:
        printDEBUG(1, "Found year in booktitle; removing it")
        printDEBUG(1, "\tBefore removing it " + entry['booktitle'])
        entry['booktitle'] = entry['booktitle'].replace(year, '')
        printDEBUG(1, "\tAfter removing it " + entry['booktitle'] + "\n")

    _abbreviate_field(entry, 'booktitle', abbr, threshold=0.8, warn_below=0.9)


def get_entry(doi: str) -> str:
    """
    Return a fully-formatted BibTeX string for *doi*.

    This is the entry point used by the CLI; it orchestrates the end-to-end
    pipeline.  The steps below are numbered to make the pipeline easy to follow.
    """
    get_linenumber()

    # 1. Fetch and parse ----------------------------------------------------
    content     = _fetch_raw_bibtex(doi)
    doi_content = content                         # kept for optional logging
    db          = _parse_bibtex(content, doi)
    entry       = db.entries[0]

    printDEBUG(1, "Just fetched: ")
    printDEBUG(1, entry)
    if DEBUG >= 1:
        get_linenumber()

    # 2. Base normalisation -------------------------------------------------
    _normalise_base_entry(entry)

    # 3. Build a nice BibTeX key --------------------------------------------
    if 'year' not in entry:
        print("Problem: no year in the fields of doi")
        print(entry)
    else:
        old_key = str(entry['ID'])
        new_key = _build_bibtex_key(entry)
        printDEBUG(1, "Replacing ID key " + old_key + " by " + new_key)
        entry['ID'] = new_key
        _log_raw_content(new_key, doi_content)

    printDEBUG(2, "Before processing but after changing the ID key")
    printDEBUG(2, entry)

    # 4. Load the @string abbreviation table --------------------------------
    abbr = _load_string_abbreviations()

    # 5. Sanitize after key generation --------------------------------------
    _sanitize_after_key(entry)
    get_linenumber()

    # 6. Publisher-specific post-processing ---------------------------------
    _handle_springer(entry); get_linenumber()
    _handle_spie(entry);     get_linenumber()
    _handle_iop(entry);      get_linenumber()

    # 7. Preprint-server handlers (dispatched by DOI prefix) ----------------
    entry = _apply_preprint_handlers(entry)
    get_linenumber()

    # 8. Abbreviation matching on the main fields ---------------------------
    _abbreviate_journal(entry, abbr)
    get_linenumber()
    _abbreviate_booktitle(entry, abbr)
    get_linenumber()

    # 9. CVPR / ACM / IEEE / MDPI specific fine-grained fixes ---------------
    _apply_cvpr_special_case(entry)

    if entry['doi'].find("10.1145/") > -1:
        handle_ACM(entry)
    get_linenumber()

    _handle_ieee(entry)

    if entry['doi'].find("10.3390/") > -1:              # MDPI editor
        entry = handle_MDPI(entry)
    get_linenumber()

    # 10. Abbreviate the address and the publisher --------------------------
    if 'address' in entry:
        printDEBUG(1, "\nTry to find abbreviated conference location for " + entry['address'])
        _abbreviate_field(entry, 'address', abbr, threshold=0.8)
    get_linenumber()

    _abbreviate_field(entry, 'publisher', abbr, threshold=0.9)

    # 11. Small finishing touches -------------------------------------------
    if 'booktitle' in entry and 'pages' not in entry:
        entry['pages'] = ''

    # MVD : the next does not work for the time being
    # _handle_elsevier(entry)

    if 'pages' in entry:
        entry['pages'] = entry['pages'].replace("--", "-")
    if 'copyright' in entry:
        printDEBUG(1, "Deleting copyright " + entry['copyright'])
        del entry['copyright']
    get_linenumber()

    # 12. arXiv "et al." expansion -----------------------------------------
    # When the author list of an arXiv entry was truncated with "et al.",
    # emit two entries built from a SINGLE arXiv abs-page scrape so that
    # both use the canonical "Last, First and Last, First and ..." form:
    #   - a short one keyed "...-etal" whose list is the first K scraped
    #     authors followed by "et al" (K = number of named authors in
    #     the original entry before its "et al." marker);
    #   - a full one whose author list is every scraped author,
    #     ASCII-cleaned.
    if entry.get('eprinttype') == 'arXiv' and author_list_has_et_al(entry.get('author', '')):
        eprint  = entry.get('eprint')
        scraped = fetch_arxiv_authors(eprint) if eprint else None
        short = build_arxiv_etal_short(entry, scraped)
        full  = build_arxiv_etal_full(entry,  scraped)
        entries = [short]
        if full is not None:
            entries.append(full)
        else:
            printDEBUG(1, "arxiv-etal: full-list scrape failed; emitting short form only")
        db.entries = entries

    # 13. Serialize ---------------------------------------------------------
    return _format_as_bibtex(db, abbr)


# ===========================================================================
# CONFERENCES WITHOUT DOI - INFRASTRUCTURE
# ===========================================================================
#
# Some major ML/AI conferences (NeurIPS/NIPS, ICML, ICLR, ...) do not assign
# DOIs to every paper.  We therefore cannot rely on ``doi.org`` and must parse
# proceedings / OpenReview URLs directly.
#
# The architecture mirrors the publisher-handler pattern used elsewhere in
# this file:
#
#   * ``ConferenceSource`` is the abstract base class.  Subclasses describe
#     *one* conference series (e.g. NeurIPS).  They declare the URL patterns
#     they recognise (``matches``) and implement the metadata extraction
#     (``fetch``).
#   * ``CONFERENCE_SOURCES`` is a simple registry of subclasses.  Adding ICML
#     or ICLR support means writing a tiny subclass and appending it to the
#     registry -- nothing else in the pipeline changes.
#   * ``resolve_input`` is the single public entry point: given either a DOI
#     or a URL, it returns a BibTeX string.  DOIs continue to flow through
#     ``get_entry``; URLs are dispatched to the first matching source.
# ---------------------------------------------------------------------------


class ConferenceSource:
    """Abstract base class for conferences that do not expose DOIs.

    Subclasses MUST set the class attributes below and override
    :meth:`matches` / :meth:`fetch`.  They MAY override :meth:`_infer_year`
    if the year is not trivially derivable from the URL.
    """

    # -- Conference identity ------------------------------------------------
    #: Short name, used only for debug messages.
    name: str = ""
    #: BibTeX ``booktitle`` string alias (e.g. ``"nips"``, ``"icml"``).
    #: The script's ``bib/strings.bib`` is expected to define this alias.
    booktitle: str = ""
    #: Publisher name; kept empty if not applicable (OpenReview has none).
    publisher: str = ""
    #: Default month for the conference, as a BibTeX month macro.
    month: str = "dec"
    #: Mapping ``year -> city macro`` (e.g. ``2024 -> 'city-vancouver'``).
    #: When the macro is missing, the raw string (``"Virtual"`` etc.) is used.
    city_by_year: Dict[int, str] = {}

    # -- URL dispatch -------------------------------------------------------
    @classmethod
    def matches(cls, url: str) -> bool:
        """Return True if this source can handle ``url``.  Override in subclass."""
        return False

    # -- Main extraction ----------------------------------------------------
    def fetch(self, url: str) -> str:
        """Return a BibTeX string for ``url``.  Override in subclass."""
        raise NotImplementedError

    # -- Helpers shared by all subclasses -----------------------------------
    def _base_entry(self, year: int, url: str) -> Dict[str, str]:
        """Return a dictionary with the generic fields common to all entries."""
        entry: Dict[str, str] = {
            "ENTRYTYPE": "inproceedings",
            "booktitle": self.booktitle,
            "year": str(year),
            "month": self.month,
            "url": url,
        }
        if self.publisher:
            entry["publisher"] = self.publisher
        city = self.city_by_year.get(year)
        if city:
            entry["address"] = city
        return entry

    @staticmethod
    def _format_authors(authors: List[str]) -> str:
        """Convert ``['First Last', 'Alice Bob']`` to a BibTeX ``and`` list.

        Names are normalised to ``Last, First Middle`` form so that BibTeX
        and the abbreviation pipeline treat them consistently.
        """
        formatted: List[str] = []
        for raw in authors:
            raw = raw.strip()
            if not raw:
                continue
            if "," in raw:
                # Already in ``Last, First`` form.
                formatted.append(raw)
                continue
            parts = raw.split()
            if len(parts) == 1:
                formatted.append(parts[0])
            else:
                last = parts[-1]
                first = " ".join(parts[:-1])
                formatted.append(f"{last}, {first}")
        return " and ".join(formatted)

    @staticmethod
    def _make_bibtex_id(authors: List[str], title: str, year: int) -> str:
        """Build an ID similar to the one produced by ``_build_bibtex_key``."""
        if authors:
            first_author = authors[0]
            if "," in first_author:
                last = first_author.split(",", 1)[0].strip()
            else:
                last = first_author.strip().split()[-1]
        else:
            last = "Anon"
        words = re.findall(r"[A-Za-z0-9]+", title)
        # BUGFIX-style guard: only use the second word if present.
        tail = words[1].capitalize() if len(words) >= 2 else (
            words[0].capitalize() if words else ""
        )
        return f"{last}{year}{tail}"

    # Subclasses that cannot derive the year from the URL alone should
    # override this.
    def _infer_year(self, url: str, html: Optional[str] = None) -> Optional[int]:
        match = re.search(r"(19|20)\d{2}", url)
        return int(match.group(0)) if match else None


#: Registry of conference handlers.  Adding support for a new DOI-less
#: conference is as simple as declaring a subclass and appending it here.
CONFERENCE_SOURCES: List[type] = []


def _extract_doi_from_url(text: str) -> Optional[str]:
    """If ``text`` looks like a DOI URL, return just the DOI part.

    Also handles arXiv abstract URLs of the form
    ``https://arxiv.org/abs/<id>`` (with or without a version suffix such
    as ``v2``), converting them to the canonical DataCite DOI
    ``10.48550/arXiv.<id>``.
    """
    # arXiv abstract or PDF URL  →  10.48550/arXiv.<id>
    # Handles both /abs/<id> and /pdf/<id> (with or without a version suffix).
    arxiv_match = re.search(
        r"arxiv\.org/(?:abs|pdf)/([0-9]{4}\.[0-9]{4,5}(?:v\d+)?|[a-z\-]+/[0-9]{7}(?:v\d+)?)",
        text.strip(),
        re.IGNORECASE,
    )
    if arxiv_match:
        arxiv_id = re.sub(r"v\d+$", "", arxiv_match.group(1))  # strip version
        return f"10.48550/arXiv.{arxiv_id}"

    match = re.search(r"(?:doi\.org/|dx\.doi\.org/)(10\.[^\s]+)", text.strip())
    if match:
        return match.group(1)
    if re.match(r"^10\.\d{3,}/", text.strip()):
        return text.strip()
    return None


def _looks_like_url(text: str) -> bool:
    return text.startswith(("http://", "https://"))


def _dispatch_conference(url: str) -> Optional[str]:
    """Return BibTeX for ``url`` if a registered source handles it, else None."""
    for src_cls in CONFERENCE_SOURCES:
        if src_cls.matches(url):
            printDEBUG(1, f"Conference source: {src_cls.name}")
            return src_cls().fetch(url)
    return None


def resolve_input(identifier: str) -> str:
    """Single public entry point: accept a DOI *or* a URL.

    The precedence is:

    1. If the input is (or contains) a DOI, hand it to the classical
       ``get_entry`` pipeline -- behaviour identical to the original script.
    2. Otherwise, if the input is a URL recognised by a registered
       :class:`ConferenceSource`, use that handler.
    3. As a last resort, fall back to ``get_entry`` so the user still sees
       the original error path.
    """
    identifier = identifier.strip()

    # Case 1: bare DOI or DOI URL.
    doi = _extract_doi_from_url(identifier)
    if doi is not None:
        return get_entry(doi)

    # Case 2: URL covered by a conference handler.
    if _looks_like_url(identifier):
        bib = _dispatch_conference(identifier)
        if bib is not None:
            return bib

    # Case 3: let the legacy pipeline handle (or reject) it.
    return get_entry(identifier)


# ===========================================================================
# CONFERENCES WITHOUT DOI - NEURIPS
# ===========================================================================
#
# NeurIPS papers appear under several URL schemes depending on the year:
#
#   * ``https://papers.nips.cc/paper/<n>-<slug>`` (pre-2020 landing pages)
#   * ``https://papers.nips.cc/paper_files/paper/<year>/hash/<hash>-Abstract...``
#   * ``https://proceedings.neurips.cc/paper/<year>/hash/<hash>-Abstract...``
#   * ``https://proceedings.neurips.cc/paper_files/paper/<year>/hash/<hash>-...``
#   * ``https://openreview.net/forum?id=<id>`` (2018+)
#   * ``https://neurips.cc/virtual/<year>/poster/<n>`` (virtual site, SPA)
#
# ``papers.nips.cc`` and ``proceedings.neurips.cc`` expose Highwire-style
# ``citation_*`` meta tags that are trivial to parse.  OpenReview has a
# stable JSON API.  The virtual site is a single-page app, so we fall back
# to Selenium (already used elsewhere in this file).
# ---------------------------------------------------------------------------


class NeurIPSSource(ConferenceSource):
    """Handler for NeurIPS / NIPS papers without a DOI."""

    name = "NeurIPS"
    booktitle = "nips"
    publisher = ""
    month = "dec"
    city_by_year = {
        1987: "city-denver",
        1988: "city-denver",
        1989: "city-denver",
        1990: "city-denver",
        1991: "city-denver",
        1992: "city-denver",
        1993: "city-denver",
        1994: "city-denver",
        1995: "city-denver",
        1996: "city-denver",
        1997: "city-denver",
        1998: "city-denver",
        1999: "city-denver",
        2000: "city-denver",
        2001: "city-vancouver",
        2002: "city-vancouver",
        2003: "city-vancouver",
        2004: "city-vancouver",
        2005: "city-vancouver",
        2006: "city-vancouver",
        2007: "city-vancouver",
        2008: "city-vancouver",
        2009: "city-vancouver",
        2010: "city-vancouver",
        2011: "city-granada",
        2012: "city-stateline",
        2013: "city-stateline",
        2014: "city-montreal",
        2015: "city-montreal",
        2016: "city-barcelona",
        2017: "city-longbeach",
        2018: "city-montreal",
        2019: "city-vancouver",
        2020: "Virtual",
        2021: "Virtual",
        2022: "city-neworleans",
        2023: "city-neworleans",
        2024: "city-vancouver",
        2025: "city-sandiego",
    }

    # -- URL dispatch -------------------------------------------------------
    _HOSTS = (
        "openreview.net",
        "proceedings.neurips.cc",
        "papers.nips.cc",
        "papers.neurips.cc",
        "neurips.cc/virtual",
    )

    @classmethod
    def matches(cls, url: str) -> bool:
        lower = url.lower()
        return any(host in lower for host in cls._HOSTS)

    # -- Main extraction ----------------------------------------------------
    def fetch(self, url: str) -> str:
        printDEBUG(1, f"NeurIPSSource.fetch({url})")
        if "openreview.net" in url:
            return self._fetch_from_openreview(url)
        if "neurips.cc/virtual" in url:
            return self._fetch_from_virtual(url)
        if "proceedings.neurips.cc" in url or "papers.nips.cc" in url \
                or "papers.neurips.cc" in url:
            return self._fetch_from_proceedings(url)
        raise ValueError(f"Unrecognised NeurIPS URL: {url}")

    # -- OpenReview ---------------------------------------------------------
    _OPENREVIEW_API_V2 = "https://api2.openreview.net/notes?id={note_id}"
    _OPENREVIEW_API_V1 = "https://api.openreview.net/notes?id={note_id}"

    def _fetch_from_openreview(self, url: str) -> str:
        match = re.search(r"[?&]id=([^&]+)", url)
        if not match:
            raise ValueError(f"No OpenReview id= parameter in URL: {url}")
        note_id = match.group(1)

        note = self._openreview_get(note_id)
        if note is None:
            raise RuntimeError(f"OpenReview note not found: {note_id}")

        content = note.get("content", {})
        title = self._openreview_field(content, "title")
        authors = self._openreview_field(content, "authors") or []
        if isinstance(authors, str):
            authors = [a.strip() for a in authors.split(",")]
        abstract = self._openreview_field(content, "abstract")
        venue = self._openreview_field(content, "venue") or ""
        # Year: prefer explicit ``pdate`` (ms since epoch), else scrape venue.
        year = self._openreview_year(note, venue)

        entry = self._base_entry(year, url)
        entry["title"] = title or ""
        entry["author"] = self._format_authors(authors)
        if abstract:
            entry["abstract"] = abstract
        entry["ID"] = self._make_bibtex_id(authors, title or "", year)
        return _post_process_conference_entry(entry)

    @staticmethod
    def _openreview_field(content: Dict, key: str):
        """OpenReview v2 wraps values in ``{"value": X}``; v1 stores X directly."""
        value = content.get(key)
        if isinstance(value, dict) and "value" in value:
            return value["value"]
        return value

    def _openreview_get(self, note_id: str) -> Optional[Dict]:
        for api in (self._OPENREVIEW_API_V2, self._OPENREVIEW_API_V1):
            try:
                response = requests.get(api.format(note_id=note_id), timeout=20)
            except requests.RequestException as exc:
                printDEBUG(2, f"OpenReview {api} failed: {exc}")
                continue
            if response.status_code != 200:
                continue
            try:
                payload = response.json()
            except ValueError:
                continue
            notes = payload.get("notes") or []
            if notes:
                return notes[0]
        return None

    def _openreview_year(self, note: Dict, venue: str) -> int:
        pdate = note.get("pdate") or note.get("cdate")
        if isinstance(pdate, (int, float)):
            try:
                return datetime.datetime.utcfromtimestamp(pdate / 1000).year
            except (ValueError, OSError):
                pass
        match = re.search(r"(19|20)\d{2}", venue)
        if match:
            return int(match.group(0))
        # Fallback: OpenReview ``forum?id=`` URLs sometimes embed the year
        # in the ``invitation`` field.
        invitation = note.get("invitation") or note.get("invitations")
        if isinstance(invitation, list):
            invitation = " ".join(invitation)
        if isinstance(invitation, str):
            match = re.search(r"(19|20)\d{2}", invitation)
            if match:
                return int(match.group(0))
        raise RuntimeError("Unable to determine NeurIPS year from OpenReview note")

    # -- papers.nips.cc / proceedings.neurips.cc ----------------------------
    def _fetch_from_proceedings(self, url: str) -> str:
        response = requests.get(url, headers=hdr, timeout=30)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, "html.parser")

        def meta(name: str) -> Optional[str]:
            tag = soup.find("meta", attrs={"name": name})
            return tag["content"].strip() if tag and tag.get("content") else None

        def meta_all(name: str) -> List[str]:
            return [t["content"].strip() for t in soup.find_all(
                "meta", attrs={"name": name}) if t.get("content")]

        title = meta("citation_title") or (soup.title.string if soup.title else "")
        authors = meta_all("citation_author")
        year_str = meta("citation_publication_date") or meta("citation_year") or ""
        year_match = re.search(r"(19|20)\d{2}", year_str)
        year: Optional[int] = int(year_match.group(0)) if year_match else None
        if year is None:
            year = self._infer_year(url, response.text)
        if year is None:
            raise RuntimeError(f"Unable to determine year for {url}")

        # Abstract: the page often has a ``<h4>Abstract</h4>`` followed by a
        # paragraph.  Be defensive; fall back to empty.
        abstract = ""
        h4 = soup.find(lambda t: t.name == "h4" and t.get_text(
            strip=True).lower() == "abstract")
        if h4:
            sibling = h4.find_next(["p", "div"])
            if sibling:
                abstract = sibling.get_text(" ", strip=True)

        entry = self._base_entry(year, url)
        entry["title"] = title or ""
        entry["author"] = self._format_authors(authors)
        if abstract:
            entry["abstract"] = abstract
        entry["ID"] = self._make_bibtex_id(authors, title or "", year)
        return _post_process_conference_entry(entry)

    # -- neurips.cc/virtual (single page app) -------------------------------
    def _fetch_from_virtual(self, url: str) -> str:
        printDEBUG(1, "NeurIPS virtual site requires a headless browser")
        options = Options()
        options.add_argument("--headless=new")
        options.add_argument("--no-sandbox")
        options.add_argument("--disable-gpu")
        driver = webdriver.Chrome(
            service=Service(ChromeDriverManager().install()),
            options=options,
        )
        try:
            driver.get(url)
            WebDriverWait(driver, 30).until(
                EC.presence_of_element_located((By.TAG_NAME, "h2")))
            # Give the SPA a beat to populate authors.
            time.sleep(1.0)
            page = driver.page_source
        finally:
            driver.quit()

        soup = BeautifulSoup(page, "html.parser")
        title_tag = soup.find(["h2", "h1"])
        title = title_tag.get_text(strip=True) if title_tag else ""
        # Authors typically appear in a container labelled ``authors``.
        authors: List[str] = []
        for node in soup.select(".author, .authors, .author-list li"):
            text = node.get_text(" ", strip=True)
            if text:
                authors.append(text)
        year = self._infer_year(url) or datetime.datetime.now().year

        entry = self._base_entry(year, url)
        entry["title"] = title
        entry["author"] = self._format_authors(authors)
        entry["ID"] = self._make_bibtex_id(authors, title, year)
        return _post_process_conference_entry(entry)


CONFERENCE_SOURCES.append(NeurIPSSource)


# ---------------------------------------------------------------------------
# Conference entry serialisation.
#
# We reuse the abbreviation-aware serialiser used for the DOI pipeline so that
# string macros (``nips``, ``city-vancouver``, ...) render without quotes.
# ---------------------------------------------------------------------------


def _post_process_conference_entry(entry: Dict[str, str]) -> str:
    """Convert a raw entry dict into a pretty BibTeX string."""
    # Guarantee required fields so downstream tools don't choke.
    entry.setdefault("ID", "UnknownKey")
    entry.setdefault("ENTRYTYPE", "inproceedings")

    db = bibtexparser.bibdatabase.BibDatabase()
    db.entries = [entry]
    abbr: Dict[str, str] = {}
    # Reuse the existing string-alias loader if bib/strings.bib is available.
    try:
        abbr = _load_string_abbreviations()
    except Exception as exc:  # pragma: no cover - defensive
        printDEBUG(2, f"Could not load string abbreviations: {exc}")
    return _format_as_bibtex(db, abbr)


