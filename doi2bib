# Springer series whose entries are actually conference proceedings.
_SPRINGER_SERIES_MARKERS: List[str] = [
    "aisc", "acvpr", "ccis", "ecpsci", "isrl", "lais", "lncs",
    "lncvb", "lndect", "lnee", "lnicst", "lnns", "mimb", "ust",
    "sist", "springer-series-sbd",
]

# First-pass hints discovered by scanning the Springer landing page.
# Format: (marker-in-HTML, target-field, value, log-friendly name)
_SPRINGER_PAGE_HINTS: List[Tuple[str, str, str, str]] = [
    ("series (ACVPR)", "journal", "acvpr",                "ACVPR"),
    ("AISC,volume",    "series",  "aisc",                 "AISC"),
    ("CCIS,volume",    "journal", "ccis",                 "CCIS"),
    ("ECPSCI,volume",  "journal", "ecpsci",               "ECPSCI"),
    ("ISRL,volume",    "journal", "isrl",                 "ISRL"),
    ("LAIS,volume",    "journal", "lais",                 "LAIS"),
    ("LNCS,volume",    "journal", "lncs",                 "LNCS"),
    ("LNEE,volume",    "series",  "lnee",                 "LNEE"),
    ("LNNS,volume",    "series",  "lnns",                 "LNNS"),
    ("SBD,volume",     "series",  "springer-series-sbd",  "SBD"),
]


def _is_springer_series(entry: dict) -> bool:
    """True iff the ``journal`` field matches a known Springer series or a
    ``series`` field has already been populated upstream."""
    if 'journal' not in entry:
        return 'series' in entry
    j = entry['journal']
    if any(marker in j for marker in _SPRINGER_SERIES_MARKERS):
        return True
    return 'series' in entry


def _handle_springer(entry: dict) -> None:
    """In-place fix-up for Springer DOIs (``10.1007/...``)."""
    if 'journal' not in entry or entry['doi'].find("10.1007/") <= -1:
        return

    printDEBUG(1, "\nSpringer editor: check if this article is within a series\n")
    printDEBUG(1, entry)

    # ---- First scan: detect the series from the landing page --------------
    page = getContentFromURL(entry['url'])
    for marker, target_field, value, name in _SPRINGER_PAGE_HINTS:
        if marker in page:
            printDEBUG(1, "\t" + name + " series detected")
            entry[target_field] = value

    # ---- Second scan: MIMB is tested separately (historical) --------------
    page = getContentFromURL(entry['url'])
    if "MIMB, volume" in page:
        printDEBUG(1, "\tMIMB series detected")
        entry['journal'] = "mimb"

    # ---- Only continue if this really is a series entry -------------------
    if not _is_springer_series(entry):
        return

    printDEBUG(1, "Springer editor: changing entry type from article to inproceedings")
    printDEBUG(1, " Found series = " + entry['journal'])

    entry['ENTRYTYPE'] = "inproceedings"
    entry.setdefault('publisher', "springer")
    entry.setdefault('series',    entry['journal'])
    entry['keywords'] = ''

    # ---- Third scan: extract booktitle / volume ---------------------------
    page = getContentFromURL(entry['url'])

    m = re.search(r'(citation_conference_title\"\scontent)=\"(.+)\"', page)
    if m:
        entry['booktitle'] = m[2]
        jabbr = journal_abbrev(entry['booktitle'])
        if jabbr != entry['booktitle']:
            entry['shortjournalproceedings'] = jabbr
        volume_match = re.search(r'(volume\s)(\d+)', page)
        entry['volume'] = volume_match.group(2)
    else:
        entry['booktitle'] = entry['journal']
        entry.setdefault('volume', '')

    del entry['journal']

    # ---- Series-specific corrections --------------------------------------
    series = entry['series']

    if "ECCV" in series:
        entry['series']    = "lncs"
        entry['booktitle'] = "eccv"

    get_linenumber()
    if "isrl" in series:
        entry['series']    = "springer-series-isrl"
        entry['ENTRYTYPE'] = "inbook"
        # BUGFIX: the original used two different regexes - ``(.+)\)`` as the
        # guard and ``(.+)\)\)`` for the extraction - which crashed when the
        # guard matched but the extraction did not.  We now ``search`` once
        # and use the (single, consistent) match object.
        volume_match = re.search(r'ISRL,volume (.+)\)', page)
        if volume_match:
            printDEBUG(1, "\t try to find the volume number")
            entry['volume'] = volume_match.group(1)
        get_linenumber()
        booktitle_match = re.search(r'inbook_title" content="([^"]+)"', page)
        if booktitle_match:
            printDEBUG(1, "\t try to find the right book title")
            entry['booktitle'] = booktitle_match.group(1)

    if "LNEE,volume" in page:
        printDEBUG(1, "   found LNEE series")
        entry['series'] = 'lnee'
        volume_match = re.search(r'LNEE,volume (.+)\)', page)
        if volume_match:
            printDEBUG(1, "\t try to find the volume number")
            entry['volume'] = volume_match.group(1)

    if "LNCVB,volume" in page:
        printDEBUG(1, "   found LNCVB series")
        volume_match = re.search(r'LNCVB,volume (.+)\)', page)
        if volume_match:
            printDEBUG(1, "\t try to find the volume number")
            entry['volume'] = volume_match.group(1)
        # BUGFIX: the booktitle extraction assumed the regex always matched and
        # crashed otherwise; we now only assign when a match is found.
        booktitle_match = re.search(r'(citation_inbook_title\"\scontent)=\"(.+)\"', page)
        if booktitle_match:
            entry['booktitle'] = booktitle_match[2]

    if "SBD,volume" in page:
        printDEBUG(1, "   found SBD series")
        volume_match = re.search(r'SBD,volume (.+)\)', page)
        if volume_match:
            printDEBUG(1, "\t try to find the volume number")
            entry['volume'] = volume_match.group(1)[:-1]   # strip trailing ')'

    printDEBUG(1, "Springer editor: changing entry type from article to inproceedings - done")


def _handle_spie(entry: dict) -> None:
    """In-place fix-up for SPIE Proceedings DOIs (``10.1117/...``)."""
    is_spie = (
        entry['doi'].find("10.1117/") > -1
        and 'booktitle' not in entry
        and entry['doi'].find("jei") <= -1
    )
    if not is_spie:
        return

    printDEBUG(1, "Found SPIE entry wrongly considered as a journal instead of proceedings")
    entry['ENTRYTYPE'] = "inproceedings"
    entry['booktitle'] = entry['journal']
    printDEBUG(1, "\tdeleting journal entry")
    del entry['journal']
    entry['publisher'] = "SPIE"
    entry['series']    = "pspie"
    entry['keywords']  = ''
    get_linenumber()

    page = getContentFromURL(entry['url'])
    re.search(r'\d+', page)                                  # preserved (no-op)
    volume_match = re.search(r'citation_volume\"\scontent=\"(.+)\"', page)
    get_linenumber()
    # BUGFIX: guard against a missing ``citation_volume`` meta tag instead of
    # unconditionally calling ``.group(1)`` (which would raise AttributeError).
    if volume_match:
        entry['volume'] = volume_match.group(1)
    get_linenumber()


def _handle_iop(entry: dict) -> None:
    """In-place fix-up for IOP Publishing DOIs (``10.1088/...``)."""
    if entry['doi'].find("10.1088/") <= -1:
        return

    printDEBUG(1, "Found IOP publisher -> check for article Conference Series")
    if 'booktitle' not in entry:
        return

    if 'Conference Series' in entry['booktitle']:
        printDEBUG(1, "Found IOP Conference Series")
        entry['series'] = "jpcs"

    # These are intentionally left for manual inspection by the user.
    entry['booktitle'] = "CHECK THIS BY HAND"
    entry['pages']     = "CHECK THIS BY HAND"
    for stale in ('number', 'address', 'shortjournalproceedings'):
        if stale in entry:
            del entry[stale]


def _handle_ieee(entry: dict) -> None:
    """Fill in missing ``pages`` / ``address`` for IEEE conferences (``10.1109/...``)."""
    is_ieee_conf = (
        entry['doi'].find("10.1109/") > -1
        and 'booktitle' in entry
    )
    if not is_ieee_conf:
        return
    printDEBUG(1, "\nThis is an IEEE conference")

    # 1. Extract the start / end pages from the landing page ----------------
    if 'pages' not in entry or len(entry['pages']) < 1:
        printDEBUG(1, "\tTry to find missing pages of an IEEE conference")
        page = getContentFromURL(entry['url'])
        if re.search(r'startPage', page) and re.search(r'endPage', page):
            start = re.search(r'startPage\":\"(\d+)\"', page)
            end   = re.search(r'endPage\":\"(\d+)\"',   page)
            printDEBUG(2, start)
            printDEBUG(2, end)
            entry['pages'] = start[1] + "-" + end[1]
            if DEBUG >= 1:
                print("\tFound page range = " + entry['pages'])
        else:
            printDEBUG(1, "\tCould not find missing page range")

    # 2. Extract the conference location ------------------------------------
    if 'address' not in entry or len(entry['address']) < 1:
        printDEBUG(1, "\tTry to find missing conference location of an IEEE conference")
        page = getContentFromURL(entry['url'])
        if re.search(r'confLoc', page):
            printDEBUG(1, "\tTrying to extract the confLoc data")
            loc = re.search(r'confLoc\":\"([\w,\s]+)\"', page)
            if loc:
                entry['address'] = loc[1]
                printDEBUG(1, "\tFound conference location = " + entry['address'])
            else:
                printDEBUG(1, "\tCould not find conference location")


def _handle_elsevier(entry: dict) -> None:
    """Attempt to fix the ``pages`` field for Elsevier DOIs (``10.1016/...``)."""
    looks_like_bad_pages = (
        entry['doi'].find("10.1016/") > -1
        and 'pages' in entry
        and entry['pages'].find("-") < 1
    )
    if not looks_like_bad_pages:
        return

    printDEBUG(
        1,
        "\nThis is a paper by the Elsevier editor and try to find the page "
        "range instead of the article number",
    )
    getContentFromURL(entry['url'])         # side-effect only, preserved for parity
    printDEBUG(
        1,
        "\tAt the present time, the script is not able to replace the article "
        "number by the page range, due to javascript issues. Sorry...",
    )


