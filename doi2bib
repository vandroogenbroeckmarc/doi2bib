def getContentFromURL(url: str) -> str:
    """
    Download *url* and return its decoded body.

    Uses ``urllib`` with a spoofed User-Agent because some publishers
    (Springer, IEEE, etc.) actively block naive HTTP clients.
    """
    opener = urllib.request.build_opener()
    opener.addheaders = list(_SPOOFED_HEADERS)
    urllib.request.install_opener(opener)

    u = urllib.request.urlopen(url)
    charset = u.headers.get_content_charset(failobj="utf-8")
    return u.read().decode(charset)


def _make_headless_chrome(**prefs) -> webdriver.Chrome:
    """Return a configured headless Chrome driver; *prefs* are forwarded to ``prefs``."""
    options = Options()
    if prefs:
        options.add_experimental_option('prefs', prefs)
    options.add_argument("--headless")
    options.add_argument("--disable-gpu")
    options.add_argument("--no-sandbox")
    return webdriver.Chrome(
        service=Service(ChromeDriverManager().install()),
        options=options,
    )


def get_fulltext_pdf_url_from_doi(doi_url: str) -> Optional[str]:
    """
    Follow *doi_url* in a headless Chrome and return the value of any
    ``<meta name="fulltext_pdf" content="...">`` tag found on the landing
    page (used by the MDPI handler).
    """
    driver = _make_headless_chrome()
    try:
        driver.get(doi_url)
        WebDriverWait(driver, 15).until(
            EC.presence_of_element_located((By.TAG_NAME, "head"))
        )
        soup = BeautifulSoup(driver.page_source, "html.parser")
        meta_tag = soup.find("meta", attrs={"name": "fulltext_pdf"})
        if meta_tag and meta_tag.has_attr("content"):
            return meta_tag["content"]
        return None
    finally:
        driver.quit()


def get_pdf_page_count(pdf_url: str) -> int:
    """Download *pdf_url* through headless Chrome and count its pages."""
    printDEBUG(1, "Get the number of page of the following PDF document : " + pdf_url)

    download_dir = os.path.abspath("selenium_download")
    os.makedirs(download_dir, exist_ok=True)
    # Clear previous downloads
    for f in os.listdir(download_dir):
        os.remove(os.path.join(download_dir, f))

    driver = _make_headless_chrome(**{
        "download.default_directory":       download_dir,
        "download.prompt_for_download":     False,
        "plugins.always_open_pdf_externally": True,
    })
    try:
        driver.get(pdf_url)
        time.sleep(10)       # wait for the download to complete
    finally:
        driver.quit()

    pdf_files = [f for f in os.listdir(download_dir) if f.endswith('.pdf')]
    if not pdf_files:
        raise FileNotFoundError("No PDF downloaded")

    pdf_path = os.path.join(download_dir, pdf_files[0])
    with open(pdf_path, 'rb') as f:
        reader = PyPDF2.PdfReader(f)
        return len(reader.pages)


# ===========================================================================
# PREPRINT / PUBLISHER HANDLERS
# ===========================================================================
#
# Each of the ``handle_*`` functions takes a BibTeX entry (a dict produced by
# ``bibtexparser``) and returns it - normally mutated in place - after having
# tagged it according to the originating preprint server or publisher.
# ---------------------------------------------------------------------------

def _tag_as_preprint(entry: dict,
                     id_suffix: str,
                     journal:   str,
                     eprinttype: str) -> dict:
    """Shared body for every "tag this entry as preprint server X" handler."""
    entry['ID']         = entry['ID'] + "-" + id_suffix
    entry['ENTRYTYPE']  = "article"
    entry['journal']    = journal
    entry['keywords']   = ''
    entry['eprinttype'] = eprinttype
    return entry


def handle_arXiV(entry: dict) -> dict:
    printDEBUG(1, "arXiv entry")
    number = entry['doi'].replace("10.48550/ARXIV.", "")
    _tag_as_preprint(entry, "arxiv", "arxiv", "arXiv")
    entry['volume'] = "abs/" + number
    entry['eprint'] = number
    entry['doi']    = entry['doi'].replace("ARXIV", "arXiv")
    entry['url']    = "https://doi.org/" + entry['doi']
    return entry


# ---------------------------------------------------------------------------
# arXiv "et al." author-list handling
# ---------------------------------------------------------------------------
# Some arXiv entries truncate the author list with "... and et al.". For
# these, the pipeline produces TWO outputs:
#   1. short form: author ends with "et al" (no "and", no dot) and the
#      key gets a trailing "-etal".
#   2. full form: author list scraped from arxiv.org/abs/<eprint>, passed
#      through the utils/bib_ascii_fix.py substitution table so the names
#      look like the rest of bib/all.bib, and keyed with the normal key.
_ET_AL_TAIL_RE  = re.compile(r'\s*and\s+et\s+al\.?\s*$', re.IGNORECASE)
_ET_AL_ALONE_RE = re.compile(r'\bet\s+al\.?\s*$',        re.IGNORECASE)

_ARXIV_META_AUTHOR_RE = re.compile(
    r'<meta\s+name=["\']citation_author["\']\s+content=["\']([^"\']+)["\']',
    re.IGNORECASE,
)

