# LaTeX-accent noise that must be stripped from the generated BibTeX key.
_KEY_REPLACEMENTS: List[Tuple[str, str]] = [
    (' ',  ''),   (':',  ''),   (',',  ''),   ('-',  ''),
    ('\u2019', ''), ('\"', ''),  ("'",  ''),
    ("{\\a}",   'a'), ("{\\`a}", 'a'), ("{\\~a}", 'a'), ("{\\aa}", 'a'),
    ("{\\c}",   'c'), ("{\\cc}", 'c'),
    ("{\\e}",   'e'), ("{\\'e}", 'e'), ("{\\`e}", 'e'),
    ('{\\i}',   'i'), ('{\\\\i}', 'i'),
    ('{\\"o}',  'o'), ('{\\o}',   'o'),
    ('{\\u}',   'u'), ('\\U',     'U'),
    ('{\\vc}',  'c'),
    ('{\\.z}',  'z'),
]


def _sanitize_key(key: str) -> str:
    """Strip whitespace, punctuation and LaTeX accents from a BibTeX key."""
    for needle, repl in _KEY_REPLACEMENTS:
        key = key.replace(needle, repl)
    return key


def _clean_title(title: str) -> str:
    """Basic title clean-up that must happen before the key is built from it."""
    replacements = [
        ("{",              ''),
        ("}",              ''),
        ("\\textendash ",  '-'),
        ("\\textendash",   '-'),
        ("\\textemdash",   ' --- '),
        ("\\textdollar",   '$'),
        ('&amp;',          '&'),          # see 10.1109/access.2021.3108565
        ("  ",             ' '),
    ]
    for src, dst in replacements:
        title = title.replace(src, dst)
    return title


def _build_bibtex_key(entry: dict) -> str:
    """
    Compose a readable BibTeX key: ``AuthorYEARFirstTitleWord`` (with a second
    title word appended when the first one is too short).
    """
    entry['title'] = _clean_title(entry['title'])

    first_author_lastname = entry['author'].split(",")[0]
    first_title_word      = entry['title'].split()[0]
    new_key = first_author_lastname + entry['year'] + first_title_word

    # Extend the key if the first title word is too short (length <= 3).
    if len(first_title_word) <= 3:
        printDEBUG(1, "Current ID of this entry (" + new_key + ") is too short")
        words = entry['title'].split()
        # BUGFIX: the original checked ``len(words) >= 1`` but then indexed
        # ``words[1]``, which crashes when the title contains a single word.
        # We now correctly require at least two words before appending one.
        if len(words) >= 2:
            new_key = new_key + words[1].capitalize()
        else:
            printDEBUG(1, "Current title is too short to add some extra content")

    return _sanitize_key(new_key)


