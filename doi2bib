# FUZZY ABBREVIATION MATCHING
# ===========================================================================

def _best_match(name: str, abbr: Dict[str, str]) -> Tuple[float, str]:
    """Return ``(best_ratio, best_key)`` of the best Levenshtein match for *name*."""
    best_ratio = 0.0
    best_key   = ''
    for k, v in abbr.items():
        ratio = lev.ratio(name, v)
        if ratio > best_ratio:
            best_ratio = ratio
            best_key   = k
    return best_ratio, best_key


def _abbreviate_field(entry: dict,
                      field_name: str,
                      abbr: Dict[str, str],
                      threshold: float,
                      *,
                      warn_below: Optional[float] = None) -> None:
    """
    If ``entry[field_name]`` is close enough to one of the values in *abbr*,
    replace it with the matching key.

    * *threshold* is the minimum Levenshtein ratio required;
    * below *warn_below* a visible message is printed so the user can verify
      the substitution manually.
    """
    if field_name not in entry:
        return
    name = entry[field_name]
    best_ratio, best_key = _best_match(name, abbr)
    if best_ratio > threshold:
        printDEBUG(2, "Changing " + name + " by ")
        printDEBUG(2, abbr[best_key])
        if warn_below is not None and best_ratio < warn_below:
            print(
                "\nVERIFY if correct: substituting\n\t"
                + name + " by\n\t " + abbr[best_key]
            )
        entry[field_name] = best_key


